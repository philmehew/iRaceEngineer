# iRaceEngineer Configuration

# iRacing connection
iracing:
  tick_rate_hz: 30           # How fast to poll shared memory

# LLM API (OpenAI-compatible — works with Ollama Cloud, OpenAI, LM Studio, etc.)
llm:
  base_url: "https://ollama.com/v1"         # Ollama Cloud endpoint
  api_key_env: "OLLAMA_API_KEY"   # Env var name, or paste the key directly
  model: "glm-5.3"
  max_tokens: 1024
  temperature: 0.3
  timeout: 5.0                             # Seconds to wait for LLM response before giving up
  retries: 2                                # Retry attempts for transient errors (rate limits, overload)
  retry_backoff: 1.0                        # Base delay between retries (seconds, scales per attempt)
  thinking: false                           # false | true | "low" | "medium" | "high" — thinking-model
                                            # reasoning control (Ollama "think" / OpenAI "reasoning_effort").
                                            # false = fastest replies; "high" = deep analysis.
                                            # Unset/empty = model default (don't send anything).

# Team identification — how to recognise your teammates
# AUTO-DETECT (default): iRacing assigns each driver a TeamName in session info.
# If you and your teammates all set the same TeamName in iRacing, they're found
# automatically — no config needed here at all.
#
# FALLBACK: If TeamName isn't set or you want to be explicit, list usernames
# or car numbers below. These are matched in addition to auto-detection.
#
# Teammates can be specified as:
#   - Plain string: matches iRacing UserName exactly, displayed as-is
#     e.g. "Wayne Smith8"
#   - Mapping (nickname: real_name): iRacing UserName is the key, real name is the value.
#     Used when the iRacing display name differs from the driver's real name.
#     e.g. Evolution: Patrik Farsang
#     Both names are shown in context: "Evolution / Patrik Farsang"
team:
  auto_detect: true              # Match drivers with the same TeamName as the player
  teammates:
    - Evolution: Patrik Farsang
    - Wayne: Wayne Smith8
    - Groove: Andre Groove
    - Dan: Dan Golden
    - Dangerous: Dave Cartnerdobbs
    - Liam: Liam Biggs
    - Dave2: David Barlow
    - Mayhem: Phil Mehew
  car_numbers: []                # Alternative: identify by car number


# Voice input/output (requires: uv sync)
# Each service has a "backend" switch plus symmetric "local:" / "remote:"
# blocks. Shared keys (mic/speaker settings) live at the service level — audio
# capture and playback always happen on THIS machine, whichever backend runs.
voice:
  stt:
    enabled: true
    backend: "local"                  # "local" (faster-whisper here) | "remote" (speaches on Strix Halo)
    # --- shared (both backends: mic capture stays local) ---
    input_device: 1                   # null = system default, or device name/index
    input_gain: 1.0                   # Mic input gain multiplier (1.0 = no boost, 2.0 = 2x louder)
    language: "en"                    # Language hint for Whisper
    # --- local backend ---
    local:
      model: "small"                  # Whisper model: tiny, small, medium, large-v3, turbo, distil-large-v3
      device: "cuda"                  # cuda or cpu — use "cpu" if iRacing stutters when Whisper runs (GPU contention)
      compute_type: "float16"         # float16 (GPU), int8 (CPU/GPU), int8_float16
      vad_filter: true                # Use Silero VAD to trim silence from recordings
    # --- remote backend ---
    remote:
      base_url: "http://192.168.0.117:9000"      # speaches endpoint
      model: "Systran/faster-whisper-small"       # model served by speaches
      timeout: 30.0                   # Seconds; server runs realtime-ish on 32 threads

  tts:
    enabled: true
    backend: "local"                  # "local" (Piper here) | "remote" (Kokoro on Strix Halo)
    # --- shared (both backends: playback stays local) ---
    output_device: null               # null = system default, or device name/index
    volume: 1.0                       # Volume multiplier (1.0 = normal; >1.0 clips safely)
    # --- local backend ---
    local:
      model: "en_GB-northern_english_male-medium"   # Piper voice model name
      voice_dir: "voices"             # Where voice .onnx files are stored
      use_cuda: true                  # GPU acceleration for Piper (requires onnxruntime-gpu)
    # --- remote backend ---
    remote:
      base_url: "http://192.168.0.117:8880"        # Kokoro-FastAPI endpoint
      voice: "bm_fable"               # bm_daniel | bm_fable | bm_george | bm_lewis
      timeout: 30.0                   # Seconds

  trigger:
    device_index: 0              # Joystick device index (use test_wheel.py to find)
    button_index: 9              # Button index on device (use test_wheel.py to find)
    # PTT is always hold-to-talk: hold button = record, release = transcribe
    max_record_seconds: 15           # Safety: auto-stop recording after this

# Spotter — real-time audio calls for car proximity and track events
spotter:
  enabled: true                           # Enable/disable spotter audio calls
  debounce_seconds: 0.5                  # Min gap between same sound (seconds)
  global_debounce_seconds: 0.5           # Min gap between any two sounds (seconds)
  closing:
    closing_threshold_mps: 0.15           # Min closing rate (m/s) to trigger alert
    ema_fast_seconds: 1.5                 # Fast EMA time constant (seconds)
    ema_slow_seconds: 4.0                 # Slow EMA time constant (seconds)
    max_gap_seconds: 10.0                  # Only alert if gap < this (seconds)
    min_gap_seconds: 1.5                   # Don't alert if car alongside (seconds)
    cooldown_seconds: 30.0                 # Min time between repeated alerts
  audio_paths:
    car_left: "audio/carleft.wav"         # Car appears on left
    car_right: "audio/carright.wav"       # Car appears on right
    three_wide: "audio/carthreewide.wav"  # Cars on both sides simultaneously
    clear: "audio/carclear.wav"            # Car clears from alongside
    fuel_five_laps: "audio/fuelfivelaps.wav"    # Fuel below 5 laps remaining
    fuel_three_laps: "audio/fuelthreelaps.wav"  # Fuel below 3 laps remaining
    fuel_two_laps: "audio/fueltwolaps.wav"      # Fuel below 2 laps remaining
    fuel_one_lap: "audio/fuelonelap.wav"        # Fuel below 1 lap remaining
    flag_yellow: "audio/flagyellow.wav"        # Yellow flag / caution
    flag_blue: "audio/flagblue.wav"            # Blue flag (faster car behind)
    flag_black: "audio/flagblack.wav"          # Black flag / disqualify
    flagfurledblack: "audio/flagfurledblack.wav"  # Furled black flag (warning)
    flag_white: "audio/flagwhite.wav"          # White flag (slow car ahead)
    flag_red: "audio/flagred.wav"              # Red flag
    flag_checkered: "audio/flagchequered.wav"  # Checkered flag
    flag_slippery: "audio/flagslippery.wav"    # Debris flag (slippery surface)
    flag_green: "audio/flaggreen.wav"          # Green flag (race start / restart)
    flagmeatball: "audio/flagmeatball.wav"     # Meatball flag (repair order)
    penalty_1x: "audio/penaltyonex.wav"         # 1x incident penalty
    penalty_2x: "audio/penaltytwox.wav"         # 2x incident penalty
    penalty_4x: "audio/penaltyfourx.wav"        # 4x incident penalty
    pit_entry: "audio/pitentry.wav"            # Entered pit road
    pit_exit: "audio/pitexit.wav"              # Exited pit road
  cooldowns:
    proximity_ms: 3000                    # Don't repeat proximity calls within 3s
    clearance_ms: 5000                    # Don't repeat clearance calls within 5s
    clear_delay_ms: 200                    # Debounce "clear" — 200ms to confirm car has cleared
    appear_delay_ms: 200                  # Debounce: car must be alongside this long before proximity fires
  fuel_cooldown_seconds: 120             # Min seconds between repeated fuel alerts of same type
  output_device: null                     # null = system default, or device name/index
  volume: 1.0                             # Volume multiplier (independent of TTS)

# Prompt configuration
prompt:
  system: |
    Race engineer. Race questions: ONE sentence max. Be brief.
    Off-topic small talk (weather banter, other drivers, general chat):
    answer naturally, still keep it to 2-3 sentences max.
    Never invent data. Trust STALE/frozen labels.
    Prior Q&A is conversation memory only — figures in it are outdated;
    always use the current snapshot for any number.
  context_depth: "full"       # "minimal", "medium", or "full"
  # minimal: position, fuel, laps remaining only
  # medium: + gaps, tyre temps, flags
  # full:   + lap time trends, nearby cars, pit window estimate, weather, damage
  include_lap_history: 5     # How many recent laps to include (full depth only)
  include_nearby_cars: 3     # How many nearby cars to report (full depth only)
  qa_history_max: 3          # Past Q&A exchanges kept for follow-up questions (0 = off, stateless)

# State tracking
state:
  track_lap_times: true       # Store per-lap data for trend analysis
  track_fuel: true             # Track fuel consumption per lap
  track_tyre_temps: true       # Track tyre temperature trends
  calibration_laps: 5          # Laps to average for auto-baseline (engine & tyre temps)
  # Optional: manual reference ranges override auto-calibration for listed fields
  # Remove or leave empty to use auto-calibration instead.
  # reference_ranges:
  #   oil_temp:
  #     normal_low: 80
  #     normal_high: 110
  #   water_temp:
  #     normal_low: 75
  #     normal_high: 105
  #   oil_press:
  #     normal_low: 3.0
  #     normal_high: 5.0

# Chat macro actions — commands the LLM can execute for the driver.
# iRacing's SDK can fire chat macros (AutoChatStr1-15 in app.ini) but not
# arbitrary chat text, so each action maps to a macro slot whose content
# carries the actual chat command. Set the slot in the sim (Options -> Chat);
# a trailing "$" in the macro text makes iRacing auto-transmit it.
# When you ask the race engineer to do something ("clear my black flag"),
# the LLM includes [CMD:<action>] in its reply and the macro fires.
chat_macros:
  # app_ini_path: "C:/Users/phil/Documents/iRacing/app.ini"  # null = auto-detect
  actions:
    clear_black_flag:
      macro: 1                  # AutoChatStr slot to fire (1-15)
      command: "!clearall$"      # expected slot content — validated against app.ini at startup
      description: "Clears your black flags (works where you have admin rights)"

# Capture/replay test mode
capture:
  interval_ms: 1000           # How often to save snapshots in capture mode
  output_dir: "./tests/sample_data"  # Where to save captured data

# Logging
logging:
  llm_query_log_dir: "logs"              # Directory for LLM query log files
  llm_query_log_file: "llm_queries.log" # Base filename (timestamp inserted before .log)
  console_log_dir: "logs"                # Directory for console mirror log files
  console_log_file: "console.log"        # Base filename (timestamp inserted before .log)
