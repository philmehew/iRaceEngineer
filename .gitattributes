# Auto detect text files and normalize to LF
* text=auto eol=lf

# Ensure shell scripts always use LF
*.sh text eol=lf

# Windows scripts should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — don't touch
*.exe binary
*.dll binary
*.png binary
*.jpg binary
*.ico binary
